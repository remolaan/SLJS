# ------------------------------------------------------------------
# LLM provider configuration.
#
# The Judge/prosecution/defense agents call a single pluggable provider.
# DeepSeek is the production provider (OpenAI-compatible chat API).
# Set DEEPSEEK_API_KEY to enable it.
#
# A built-in "stub" provider (LLM_PROVIDER=stub) lets you run the whole
# LangGraph pipeline end-to-end WITHOUT any network or API key. It emits
# deterministic, role-aware placeholder text so you can test the state
# machine, RAG wiring, and API responses before live model calls work.
# ------------------------------------------------------------------

# Provider: "deepseek" | "openrouter" | "minimax" | "stub"
# If LLM_PROVIDER is not deepseek with a key, but OPENROUTER_API_KEY is set,
# the trial agents (prosecution/defense/judge/intake) automatically run on
# free OpenRouter models (rotating across several to avoid rate limits).
LLM_PROVIDER=openrouter

# DeepSeek (OpenAI-compatible). Leave DEEPSEEK_API_KEY empty to fall back
# to the stub provider automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.4

# UI/design helper via OpenRouter (free MiniMax M3).
# Used by /api/ui/design-copy to generate courtroom UI copy and scene prompts.
# Also the default model for the trial agents; the app rotates across the
# free_models list if this one is rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
UI_MODEL=minimax/minimax-m3:free
UI_PROVIDER=openrouter

# Developer/coding helper model (free OpenRouter). Used by the ai_agent CLI.
DEV_MODEL=minimax/minimax-m3:free

# RAG / embeddings
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=data/vectorstore
CORPUS_DIR=data/corpus
RAG_TOP_K_STATUTES=6
RAG_TOP_K_PRECEDENT=5
RAG_ENABLED=true

# Image generation — FREE. Uses MiniMax M3 (:free) to produce SVG avatars and
# scenes (MiniMax outputs text, so we ask it for SVG). No paid image models.
# Leave OPENROUTER_API_KEY empty to use the offline SVG stub provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL=minimax/minimax-m3:free
IMAGE_ENABLED=true

# App
APP_HOST=0.0.0.0
APP_PORT=8000